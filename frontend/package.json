{
  "name": "newshop-client",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "axios": "^1.7.9",
    "chart.js": "^4.5.1",
    "cra-template": "1.2.0",
    "lucide-react": "^0.479.0",
    "papaparse": "^5.5.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.3.5",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.1.3",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "cy:open": "ELECTRON_RUN_AS_NODE= cypress open",
    "cy:run": "ELECTRON_RUN_AS_NODE= cypress run",
    "cy:report:clean": "rm -rf cypress/reports",
    "cy:report:merge": "mochawesome-merge \"cypress/reports/.jsons/*.json\" > cypress/reports/report.json",
    "cy:report:html": "marge cypress/reports/report.json --reportDir cypress/reports --inline --reportTitle \"頸椎分析系統 - 醫枕推薦測試報告\" --reportPageTitle \"頸椎分析測試報告\"",
    "cy:test": "npm run cy:report:clean && ELECTRON_RUN_AS_NODE= cypress run; npm run cy:report:merge && npm run cy:report:html"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "cypress": "^15.17.0",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^4.4.1",
    "mochawesome-report-generator": "^6.3.2",
    "web-vitals": "^4.2.4"
  }
}
